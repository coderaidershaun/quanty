# Jev key for PDF conversion.
CONVERTER_JEV_API_KEY=
# Gemini key for embeddings.
EMBEDDING_GEMINI_API_KEY=

# Bind address; a non-loopback address requires a password.
QUANTY_LISTEN=127.0.0.1:7878
# Shared browser password; blank disables login on loopback.
QUANTY_PASSWORD=
# Bearer token for /mcp; blank disables the endpoint.
QUANTY_MCP_TOKEN=
# Persistent cookie signing key: generate 64 hex characters with openssl rand -hex 32.
QUANTY_SESSION_KEY=
# Largest PDF upload in MiB.
QUANTY_UPLOAD_LIMIT_MB=1024

# Qdrant gRPC address, using port 6334.
QDRANT_URL=http://localhost:6334
# Qdrant API key when authentication is enabled.
QDRANT_API_KEY=
# Redis with the FalkorDB graph module.
FALKORDB_URL=falkor://localhost:6379
# FalkorDB password when authentication is enabled.
FALKORDB_PASSWORD=
# Graph containing the library.
FALKORDB_GRAPH=quanty
# Collection of item vectors.
QDRANT_ITEMS_COLLECTION=items
# Collection of concept vectors.
QDRANT_CONCEPTS_COLLECTION=concepts
# Converted pages, pictures, source uploads and insights.
CONTENT_DIR=content
# Kept concept extraction answers.
CONCEPT_CACHE_DIR=data/concept-cache
# Record of concept identity decisions.
CONCEPT_DECISION_LOG=data/concept-decisions.jsonl
# Built training datasets.
DATASET_DIR=datasets
# Kept dataset model answers.
DATASET_CACHE_DIR=data/dataset-cache

# Default agent provider before saved per-work model choices.
LLM_PROVIDER=codex
# Default model before saved per-work model choices.
LLM_MODEL=gpt-6.1-sol
# Default thinking level before saved per-work model choices.
LLM_THINKING=medium
# Optional Claude subscription token from claude setup-token; keep ANTHROPIC_API_KEY unset.
# CLAUDE_CODE_OAUTH_TOKEN=
