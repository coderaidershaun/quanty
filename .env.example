CONVERTER_JEV_API_KEY=PLEASE_PROVIDE # For JEV, which `ocr` and `rag-ingest pdf` ask whether a page holds math
EMBEDDING_GEMINI_API_KEY=ENTER # For Gemini Embeddings

# Optional. Without them the local Docker stores and the collection `items` are used.
# QDRANT_URL=http://localhost:6334 # The gRPC port, not 6333
# FALKORDB_URL=falkor://localhost:6379
# FALKORDB_GRAPH=quanty # The graph that documents and items are written to
# QDRANT_ITEMS_COLLECTION=items
# QDRANT_CONCEPTS_COLLECTION=concepts # Where the vectors of concepts are stored, one point for each concept
# CONCEPT_CACHE_DIR=data/concept-cache # Where the answers of concept extraction are kept, so that a second run asks claude nothing
# CONCEPT_DECISION_LOG=data/concept-decisions.jsonl # Every decision about which stored concept a name belongs to is added here, one line each
# CONTENT_DIR=content # Where the converted files of a picture that stands alone, and of the chapters that `rag-ingest pdf` converts, are saved
