[Unit]
Description=Quanty web app and MCP server
After=network-online.target qdrant.service redis-server.service
Wants=network-online.target

[Service]
User=quanty
Group=quanty
WorkingDirectory=/srv/quanty
EnvironmentFile=/srv/quanty/.env
Environment=PATH=/srv/quanty/.local/bin:/srv/quanty/.npm-global/bin:/srv/quanty/.cargo/bin:/opt/node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/quanty --listen 127.0.0.1:7878
Restart=on-failure
UMask=0077

[Install]
WantedBy=multi-user.target
